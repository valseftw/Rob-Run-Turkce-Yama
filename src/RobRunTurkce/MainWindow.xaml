<Window x:Class="RobRunTurkce.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROB RUN Türkçe Yama" Width="1040" Height="700" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" Background="#1C1C1E" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Border x:Name="WindowFrame" BorderBrush="#3A3A3C" BorderThickness="1" Background="#1C1C1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ================= Kenar çubuğu (görsel + adımlar) ================= -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Image x:Name="SidebarImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E6141416" Offset="0"/>
                        <GradientStop Color="#C4141416" Offset="0.30"/>
                        <GradientStop Color="#8C141416" Offset="0.58"/>
                        <GradientStop Color="#F2141416" Offset="0.86"/>
                        <GradientStop Color="#FF141416" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle HorizontalAlignment="Right" Width="1" Fill="#30FFFFFF"/>

            <DockPanel Margin="26,52,26,24">
                <!-- üst: marka -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="11" Effect="{StaticResource SoftShadow}">
                        <Border.Background><ImageBrush x:Name="LogoBrush" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Türkçe Yama" FontFamily="{StaticResource Display}" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="ROB RUN için" Foreground="#C7C7CC" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- üst: Yama / Rehber geçişi -->
                <Border DockPanel.Dock="Top" Margin="0,26,0,0" CornerRadius="9" Background="#B3303034" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="2">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ModePatch" Style="{StaticResource Segment}" GroupName="mode" IsChecked="True" Content="Yama"/>
                        <RadioButton x:Name="ModeWiki" Style="{StaticResource Segment}" GroupName="mode" Content="Rehber"/>
                    </UniformGrid>
                </Border>

                <!-- alt: hazırlayan -->
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Background="#B32C2C2E" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="HAZIRLAYAN" Foreground="#98989F" FontSize="10.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Rob Run: Türkiye Official Server" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Kefir ile bağlantısı yoktur, resmi değildir." Foreground="#98989F" FontSize="11.5" Margin="0,3,0,12" TextWrapping="Wrap"/>
                        <Button x:Name="SidebarDiscord" Style="{StaticResource DiscordButton}" HorizontalAlignment="Stretch" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Discord'a Katıl" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- güncelleme bildirimi (GitHub'da imzalı yeni sürüm varsa görünür) -->
                <Border x:Name="UpdateCard" DockPanel.Dock="Bottom" Visibility="Collapsed" CornerRadius="14" Background="#CC0A2A4A" BorderBrush="#660A84FF" BorderThickness="1" Padding="16,13" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="#64D2FF" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="UpdateTitle" Text="Yeni sürüm hazır" FontWeight="SemiBold" FontSize="13.5"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateText" Foreground="#C7C7CC" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Height="32" Content="Güncelle"/>
                    </StackPanel>
                </Border>

                <!-- orta: adım listesi -->
                <Grid>
                    <StackPanel x:Name="StepList" Margin="2,30,0,0"/>
                    <ContentControl x:Name="WikiNavHost" Margin="-6,22,-6,0" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- ================= Sağ taraf ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- başlık çubuğu -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="WindowTitle" Text="ROB RUN Türkçe Yama Yükleyicisi" Foreground="#98989F" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,138,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="FullButton" Style="{StaticResource CaptionButton}" Content="&#xE740;" ToolTip="Tam ekran (F11)" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>

            <!-- sayfalar -->
            <Grid x:Name="PageHost" Grid.Row="1" Margin="44,6,44,0">

                <!-- ===== 1) Giriş ===== -->
                <ScrollViewer x:Name="PageIntro" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,18">
                        <Border CornerRadius="16" Height="150" Effect="{StaticResource CardShadow}" ClipToBounds="False">
                            <Grid>
                                <Border CornerRadius="16">
                                    <Border.Background><ImageBrush x:Name="HeroBrush" Stretch="UniformToFill" AlignmentY="Top" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0.06,1,0.62"/></Border.Background>
                                </Border>
                                <Border CornerRadius="16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.45"/>
                                            <GradientStop Color="#B3000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="16" BorderBrush="#26FFFFFF" BorderThickness="1"/>
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,0,16" Orientation="Horizontal">
                                    <Border Background="#33FFFFFF" CornerRadius="10" Padding="10,4">
                                        <TextBlock Text="4.822 METİN · TAMAMEN TÜRKÇE" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,26,0,0" Style="{StaticResource LargeTitle}">
                            <Run Text="ROB RUN'ı artık"/>
                            <Run Text="Türkçe" Foreground="#0A84FF"/>
                            <Run Text="oyna."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                                   Text="Menüler, eşyalar, görevler, ipuçları ve NPC diyalogları doğal, oyuncu diliyle Türkçe. Oyunun yazı tiplerinde olmayan ı, İ, ş, Ş, ğ, Ğ harfleri de eklenir."/>

                        <UniformGrid x:Name="StatGrid" Columns="3" Margin="0,22,0,0"/>

                        <TextBlock Text="AÇIK KAYNAK VE GÜVEN" Style="{StaticResource SectionHeader}" Margin="14,26,0,7"/>
                        <Border x:Name="TrustList" Style="{StaticResource Card}"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11.5" LineHeight="16" Margin="14,8,14,0"
                                   Text="Bağlantılar tarayıcında açılır. Program yalnızca GitHub’dan imzalı güncelleme alır. Exe Windows kod imzası taşımadığı için Windows bir uyarı gösterebilir."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 2) Riskler ===== -->
                <Grid x:Name="PageRisks" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Riskler ve koşullar" Style="{StaticResource LargeTitle}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="Lütfen aşağıdakileri dikkatle oku. Devam ettiğinde riskleri kabul edip etmediğin sorulacak; reddedersen hiçbir dosya değişmez."/>
                    <UniformGrid x:Name="RiskTiles" Grid.Row="2" Columns="3" Margin="0,18,0,0"/>
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,18" Padding="22,16,8,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="RiskText" TextWrapping="Wrap" FontSize="13.5" LineHeight="21" Foreground="#D1D1D6" Margin="0,0,14,0"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== 3) Kurulum ===== -->
                <ScrollViewer x:Name="PageInstall" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,18">
                        <TextBlock Text="Kurulum" Style="{StaticResource LargeTitle}"/>
                        <TextBlock x:Name="InstallSubtitle" Style="{StaticResource Body}" Margin="0,6,0,0"
                                   Text="Türkçe yama aşağıdaki oyuna kurulacak. Oyun klasöründeki hiçbir dosya değiştirilmez."/>

                        <!-- hedef kartı -->
                        <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18" Effect="{StaticResource SoftShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="13">
                                    <Border.Background><ImageBrush x:Name="TargetBrush" Stretch="UniformToFill"/></Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ROB RUN" FontSize="16" FontWeight="SemiBold"/>
                                        <Border x:Name="StatusPill" CornerRadius="9" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="#333A3A3C">
                                            <TextBlock x:Name="StatusPillText" Text="Kurulu değil" FontSize="11.5" FontWeight="SemiBold" Foreground="#98989F"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="GamePath" Foreground="#98989F" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="ChangeFolder" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Değiştir…" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="KURULACAK DOSYALAR · OYUNUN ÖNBELLEĞİ" Style="{StaticResource SectionHeader}" Margin="14,24,0,7"/>
                        <Border x:Name="FileList" Style="{StaticResource Card}"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="11.5" LineHeight="16" Margin="14,8,14,0"
                                   Text="Konum: AppData\LocalLow\Kefir\ROB RUN\com.unity.addressables. Oyun klasörü (Steam) değişmez; kaldırınca bu dosyalar silinir. Oyunda dil English seçili olmalı."/>

                        <!-- ilerleme -->
                        <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,16" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ProgressTitle" Text="Kuruluyor…" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock x:Name="ProgressStep" HorizontalAlignment="Right" Foreground="#98989F" FontSize="12.5"/>
                                </Grid>
                                <Grid Height="6" Margin="0,12,0,0">
                                    <Border CornerRadius="3" Background="#3A3A3C"/>
                                    <Border x:Name="ProgressFill" CornerRadius="3" Background="#0A84FF" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <Button x:Name="ToggleLog" Style="{StaticResource LinkButton}" Content="Ayrıntıları göster" HorizontalAlignment="Left" FontSize="12.5" Margin="-4,8,0,0"/>
                                <TextBox x:Name="LogBox" Visibility="Collapsed" Height="110" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="#1C1C1E" Foreground="#98989F" BorderThickness="0" FontFamily="{StaticResource Mono}" FontSize="11.5" Padding="10,8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 4) Özet ===== -->
                <ScrollViewer x:Name="PageDone" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,6,18" HorizontalAlignment="Center" Width="520">
                        <Grid Width="96" Height="96" Margin="0,8,0,0">
                            <Ellipse x:Name="DoneCircle" Fill="#30D158" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="DoneScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                                <Ellipse.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#30D158" Opacity="0.45"/></Ellipse.Effect>
                            </Ellipse>
                            <Path x:Name="DoneCheck" Data="M 28,50 L 43,64 L 69,35" Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  StrokeDashArray="12 12" StrokeDashOffset="0"/>
                        </Grid>
                        <TextBlock x:Name="DoneTitle" Text="Türkçe yama kuruldu" Style="{StaticResource LargeTitle}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                        <TextBlock x:Name="DoneText" Style="{StaticResource Body}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Text="ROB RUN artık Türkçe. Oyunu açıp keyfini çıkar."/>
                        <TextBlock Text="SONRAKİ ADIMLAR" Style="{StaticResource SectionHeader}" Margin="14,30,0,7"/>
                        <Border x:Name="NextList" Style="{StaticResource Card}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Rehber (wiki) görünümü: sayfaların ve alt çubuğun yerine geçer -->
            <ContentControl x:Name="WikiHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"/>

            <!-- alt çubuk -->
            <Border x:Name="FooterBar" Grid.Row="2" BorderBrush="#2E2E30" BorderThickness="0,1,0,0" Padding="40,16,44,18">
                <DockPanel>
                    <StackPanel x:Name="FooterLeft" Orientation="Horizontal" DockPanel.Dock="Left"/>
                    <StackPanel x:Name="FooterRight" Orientation="Horizontal" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- ===== Kabul penceresi (macOS lisans "sheet"i gibi üstten kayar) ===== -->
            <Grid x:Name="SheetLayer" Grid.RowSpan="3" Visibility="Collapsed">
                <Rectangle x:Name="SheetDim" Fill="#99000000"/>
                <Border x:Name="Sheet" Width="470" VerticalAlignment="Top" Margin="0,40,0,0" CornerRadius="0,0,16,16" Background="#2C2C2E"
                        BorderBrush="#3A3A3C" BorderThickness="1,0,1,1" Padding="28,26,28,22">
                    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.55"/></Border.Effect>
                    <Border.RenderTransform><TranslateTransform x:Name="SheetMove"/></Border.RenderTransform>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Left">
                            <Border.Background><ImageBrush x:Name="SheetLogo" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <TextBlock Text="Devam etmek için risklerin koşullarını kabul etmen gerekiyor." FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="13" LineHeight="19" Margin="0,8,0,0"
                                   Text="Kabul edersen yamayı kendi isteğinle ve hesap riskini bilerek kurmuş olursun. Reddedersen kurulum yapılmaz ve hiçbir dosya değişmez."/>
                        <CheckBox x:Name="AcceptSwitch" Style="{StaticResource Switch}" Margin="0,18,0,0">
                            <TextBlock Text="Riskleri okudum ve anladım." Foreground="#F5F5F7" FontSize="13.5"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="SheetDecline" Style="{StaticResource DangerButton}" Content="Reddet"/>
                            <Button x:Name="SheetAccept" Style="{StaticResource PrimaryButton}" Content="Kabul Ediyorum" Margin="10,0,0,0" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
